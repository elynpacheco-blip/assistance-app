# Supabase Configuration
# Reemplaza con la URL de tu proyecto de Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Reemplaza con la clave pública anónima (anon public key) de Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_clave_anon_aqui

# Admin Portal Access
# Contraseña para ingresar al panel de administración (/admin)
NEXT_PUBLIC_ADMIN_PASSWORD=tu_contraseña_aqui
